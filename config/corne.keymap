#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define MED 1
#define NAV 2
#define MSE 3
#define SYM 4
#define NUM 5
#define FUN 6

/ {
    macros {
        new_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>, <&macro_press>;

            label = "NEW_MACRO";
        };
    };

    behaviors {
        bt_0_mgmt: bt_0_mgmt {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_0_MGMT";
            bindings = <&bt BT_SEL 0>, &bt BT_SEL 0 &bt BT_CLR;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bt_1_mgmt: bt_1_mgmt {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_1_MGMT";
            bindings = <&bt BT_SEL 1>, &bt BT_SEL 1 &bt BT_CLR;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bt_2_mgmt: bt_2_mgmt {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_2_MGMT";
            bindings = <&bt BT_SEL 2>, &bt BT_SEL 2 &bt BT_CLR;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bt_3_mgmt: bt_3_mgmt {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_3_MGMT";
            bindings = <&bt BT_SEL 3>, &bt BT_SEL 3 &bt BT_CLR;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bt_4_mgmt: bt_4_mgmt {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_4_MGMT";
            bindings = <&bt BT_SEL 4>, &bt BT_SEL 4 &bt BT_CLR;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&none      &kp Q       &kp W       &kp E        &kp R      &kp T             &kp Y             &kp U       &kp I        &kp O       &kp P          &none
&none      &mt LGUI A  &mt LALT S  &mt LCTRL D  &kp F      &kp G             &kp H             &kp J       &mt RCTRL K  &mt RALT L  &mt RGUI SEMI  &none
&kp LSHFT  &kp Z       &kp X       &kp C        &kp V      &kp B             &kp N             &kp M       &kp COMMA    &kp DOT     &kp FSLH       &kp RSHFT
                                   &lt 1 ESC    &lt 2 TAB  &mt LSHIFT RET    &mt RSHIFT SPACE  &lt 3 BSPC  &lt 4 DEL
            >;
        };

        Media {
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans    &trans      &trans        &trans        &trans      &trans      &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp C_PREV  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT  &trans      &trans
&trans  &trans    &trans    &trans     &trans     &trans    &bt_0_mgmt  &bt_1_mgmt    &bt_2_mgmt    &bt_3_mgmt  &bt_4_mgmt  &trans
                            &trans     &trans     &trans    &kp C_STOP  &kp C_PP      &kp K_MUTE
            >;
        };

        Nav {
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans    &kp C_AC_REDO  &kp C_AC_PASTE  &kp C_AC_COPY  &kp C_AC_CUT  &kp C_AC_UNDO  &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp LEFT       &kp DOWN        &kp UP         &kp RIGHT     &kp CAPS       &trans
&trans  &trans    &trans    &trans     &trans     &trans    &kp HOME       &kp PAGE_DOWN   &kp PG_UP      &kp END       &kp INS        &trans
                            &trans     &trans     &trans    &kp SPACE      &kp BSPC        &kp DEL
            >;
        };

        Sym {
            bindings = <
&trans  &kp LBRC   &kp AMPS  &kp STAR   &kp LPAR   &kp RBRC     &trans  &trans     &trans     &trans    &trans    &trans
&trans  &kp COLON  &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS     &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
&trans  &kp TILDE  &kp EXCL  &kp AT     &kp HASH   &kp PIPE     &trans  &trans     &trans     &trans    &trans    &trans
                             &kp LPAR   &kp RPAR   &kp UNDER    &trans  &trans     &trans
            >;
        };

        Num {
            bindings = <
&trans  &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT     &trans  &trans     &trans     &trans    &trans    &trans
&trans  &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL    &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
&trans  &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH     &trans  &trans     &trans     &trans    &trans    &trans
                           &kp DOT  &kp N0  &kp MINUS    &trans  &trans     &trans
            >;
        };
    };
};
