#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/42.h"

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // Left-hand keys.
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5 // Right-hand keys.
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                                      // Thumb keys.


#define DEF 0
#define MED 1
#define NAV 2
#define MSE 3
#define SYM 4
#define NUM 5
#define FUN 6

/* Left-hand HRMs. */
ZMK_HOLD_TAP(hml,
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;
)

/* Right-hand HRMs. */
ZMK_HOLD_TAP(hmr,
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
)

/ {
     behaviors {
        bt_0_mgmt: bt_0_mgmt {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_0_MGMT";
            bindings = <&bt BT_SEL 0>, <&bt BT_SEL 0 &bt BT_CLR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bt_1_mgmt: bt_1_mgmt {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_1_MGMT";
            bindings = <&bt BT_SEL 1>, <&bt BT_SEL 1 &bt BT_CLR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bt_2_mgmt: bt_2_mgmt {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_2_MGMT";
            bindings = <&bt BT_SEL 2>, <&bt BT_SEL 2 &bt BT_CLR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bt_3_mgmt: bt_3_mgmt {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_3_MGMT";
            bindings = <&bt BT_SEL 3>, <&bt BT_SEL 3 &bt BT_CLR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bt_4_mgmt: bt_4_mgmt {
            compatible = "zmk,behavior-mod-morph";
            label = "BT_4_MGMT";
            bindings = <&bt BT_SEL 4>, <&bt BT_SEL 4 &bt BT_CLR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
&kp LALT      &kp Q        &kp W        &kp E         &kp R       &kp T             &kp Y             &kp U       &kp I         &kp O        &kp P          &kp RALT
&kp LGUI      &hml LGUI A  &hml LALT S  &hml LCTRL D  &kp F       &kp G             &kp H             &kp J       &hmr RCTRL K  &hmr RALT L  &hmr RGUI SQT  &kp RGUI
&kp LCTRL     &kp Z        &kp X        &kp C         &kp V       &kp B             &kp N             &kp M       &kp COMMA     &kp DOT      &kp FSLH       &kp RCTRL
                                        &lt 1 ESC     &lt 2 SPACE &mt LSHIFT TAB    &mt RSHIFT RET    &lt 3 BSPC  &lt 4 DEL
            >;
        };

        Media {
            display-name = "Media";
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans    &trans      &trans        &trans        &trans      &trans      &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp C_PREV  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT  &trans      &trans
&trans  &trans    &trans    &trans     &trans     &trans    &bt_0_mgmt  &bt_1_mgmt    &bt_2_mgmt    &bt_3_mgmt  &bt_4_mgmt  &trans
                            &trans     &trans     &trans    &kp C_STOP  &kp C_PP      &kp K_MUTE
            >;
        };

        Nav {
            display-name = "Nav";
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans    &kp C_AC_REDO  &kp C_AC_PASTE  &kp C_AC_COPY  &kp C_AC_CUT  &kp C_AC_UNDO  &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp LEFT       &kp DOWN        &kp UP         &kp RIGHT     &kp CAPS       &trans
&trans  &trans    &trans    &trans     &trans     &trans    &kp HOME       &kp PAGE_DOWN   &kp PG_UP      &kp END       &kp INS        &trans
                            &trans     &trans     &trans    &kp SPACE      &kp BSPC        &kp DEL
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
&trans  &kp LBRC   &kp AMPS  &kp STAR   &kp LPAR   &kp RBRC     &trans  &trans     &trans     &trans    &trans    &trans
&trans  &kp COLON  &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS     &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
&trans  &kp TILDE  &kp EXCL  &kp AT     &kp HASH   &kp PIPE     &trans  &trans     &trans     &trans    &trans    &trans
                             &kp LPAR   &kp RPAR   &kp UNDER    &trans  &trans     &trans
            >;
        };

        Num {
            display-name = "Num";
            bindings = <
&trans  &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT     &trans  &trans     &trans     &trans    &trans    &trans
&trans  &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL    &trans  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans
&trans  &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH     &trans  &trans     &trans     &trans    &trans    &trans
                           &kp DOT  &kp N0  &kp MINUS    &trans  &trans     &trans
            >;
        };
    };
};
